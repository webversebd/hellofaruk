# PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://user:password@host:5432/hellofaruk?sslmode=require"

# Session signing secret: generate with `openssl rand -base64 32`
AUTH_SECRET=""

# First admin account (used only by `npm run db:seed`)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="choose-a-strong-password-12+chars"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="https://hellofaruk.com"

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (contact form email)
RESEND_API_KEY=""
RESEND_FROM="Faruk Hasan <noreply@hellofaruk.com>"

# Optional: Cloudflare Turnstile spam protection (leave blank to use honeypot + rate limit only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
